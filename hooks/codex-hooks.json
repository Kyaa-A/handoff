{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/check-update.mjs\" --platform codex --root \"$PLUGIN_ROOT\" --data \"$PLUGIN_DATA\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\check-update.mjs\" --platform codex --root \"%PLUGIN_ROOT%\" --data \"%PLUGIN_DATA%\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
